<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LuxMap.Persistence\LuxMap.Persistence.csproj" />
    <!-- The module assemblies are referenced so BannedBulkWriteApiTests can RESOLVE the entity type a
         bulk write targets and ask whether it implements ICommuneScoped. They are plain class
         libraries: this assembly still needs no database and no Docker, which is the whole reason the
         compile-time guards live here. -->
    <ProjectReference Include="..\..\src\LuxMap.Modules.Assets\LuxMap.Modules.Assets.csproj" />
    <ProjectReference Include="..\..\src\LuxMap.Modules.Identity\LuxMap.Modules.Identity.csproj" />
    <ProjectReference Include="..\..\src\LuxMap.Modules.Faults\LuxMap.Modules.Faults.csproj" />
    <ProjectReference Include="..\..\src\LuxMap.Modules.Survey\LuxMap.Modules.Survey.csproj" />
  </ItemGroup>

</Project>