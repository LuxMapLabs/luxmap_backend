# BE-02 — môi trường dev cục bộ.
# Dùng: cp .env.example .env
# File .env thật KHÔNG commit (đã có trong .gitignore).

# --- PostgreSQL + PostGIS ---
POSTGRES_DB=luxmap_dev
POSTGRES_USER=luxmap

# Chỉ dùng cho dev cục bộ. Môi trường thật phải lấy từ secret store, không phải file này.
POSTGRES_PASSWORD=luxmap_local_dev

# Cổng trên MÁY HOST. Mặc định 5433 chứ không phải 5432 vì máy dev
# có thể đang chạy PostgreSQL cài native chiếm sẵn 5432.
POSTGRES_PORT=5433

# --- Redis ---
# Cùng lý do: 6380 để tránh đụng Redis cài native ở 6379.
REDIS_PORT=6380

# --- Tài khoản seed (BE-06) ---
# Chỉ dùng cho dev cục bộ. Seed sẽ DỪNG với thông báo rõ nếu thiếu bất kỳ biến nào,
# không lặng lẽ đặt mật khẩu mặc định.
SEED_ADMIN_PASSWORD=doi_mat_khau_nay_01
SEED_AGENCY_PASSWORD=doi_mat_khau_nay_02
SEED_ENGINEER_PASSWORD=doi_mat_khau_nay_03
SEED_CREW_PASSWORD=doi_mat_khau_nay_04
