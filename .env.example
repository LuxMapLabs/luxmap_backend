# BE-02 — local development environment.
# Usage: cp .env.example .env
# The real .env is NEVER committed (it is already in .gitignore).

# --- PostgreSQL + PostGIS ---
POSTGRES_DB=luxmap_dev
POSTGRES_USER=luxmap

# Local development only. Real environments must pull this from a secret store, not from this file.
POSTGRES_PASSWORD=luxmap_local_dev

# Port on the HOST machine. 5433 rather than 5432 because a developer machine often already runs a
# native PostgreSQL on 5432.
POSTGRES_PORT=5433

# --- Redis ---
# Same reasoning: 6380 avoids clashing with a native Redis on 6379.
REDIS_PORT=6380

# --- Seeded accounts (BE-06) ---
# Local development only. Seeding STOPS with a clear message if any variable is missing rather than
# quietly falling back to a default password.
SEED_ADMIN_PASSWORD=change_this_password_01
SEED_AGENCY_PASSWORD=change_this_password_02
SEED_ENGINEER_PASSWORD=change_this_password_03
SEED_CREW_PASSWORD=change_this_password_04

# --- JWT signing key (BE-07) ---
# HS256, at least 32 bytes. The app STOPS at startup if it is missing or too short.
# Generate a new one: openssl rand -base64 48
JWT_SIGNING_KEY=replace_with_a_real_key_of_at_least_32_bytes_do_not_use_this
