# OPS-DEPLOY-VPS — production configuration. `cp .env.example .env`, then replace EVERY `CHANGE_ME`.
# The real .env stays on the server only (chmod 600); it is git-ignored and never committed or sent in chat.
# Generate each secret separately: `openssl rand -base64 48 | tr -d '/+=' | cut -c1-40`

# --- Public address ---
# The domain the server's DNS A record points at. Web at https://<domain>/, API at https://<domain>/api/v1.
LUXMAP_DOMAIN=luxmap.com.vn
# Let's Encrypt account e-mail: expiry warnings go here.
ACME_EMAIL=CHANGE_ME@example.com
# Required by the API outside Development; one origin, so the same domain. Exact https origin, no trailing slash.
Cors__AllowedOrigins__0=https://luxmap.com.vn
# Invitation and password-reset links point at <this>/set-password?token=...
WEB_APP_BASE_URL=https://luxmap.com.vn

# --- Database (PostGIS on this server) ---
POSTGRES_DB=luxmap
POSTGRES_USER=luxmap
POSTGRES_PASSWORD=CHANGE_ME

# --- Object store (MinIO on this server) ---
# One pair: MinIO's root credential AND the one the API signs requests with.
MINIO_ACCESS_KEY=luxmap
MINIO_SECRET_KEY=CHANGE_ME

# --- JWT signing key (HS256, at least 32 bytes) ---
JWT_SIGNING_KEY=CHANGE_ME

# --- Outgoing mail (Gmail SMTP with an app password, written WITHOUT the spaces Google shows) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME@gmail.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_ADDRESS=CHANGE_ME@gmail.com
SMTP_FROM_NAME=LuxMap

# --- Seed accounts: read ONLY by `docker compose run --rm api --seed` on an EMPTY database ---
# These become the four demo accounts' real passwords on the internet: long, unique, kept in a password manager.
# Seeding skips accounts that already exist, so after a copy from luxmap_dev these are NOT used (vps.md step 7).
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_AGENCY_PASSWORD=CHANGE_ME
SEED_ENGINEER_PASSWORD=CHANGE_ME
SEED_CREW_PASSWORD=CHANGE_ME

# --- Lighting devices ---
# http: devices poll https://<domain>/api/v1/device/... (no broker on this server, see docs/deploy/vps.md).
Lighting__Channel=http

# --- Survey processing (BE-15) ---
# Off until the D-07 gate is lifted: with the worker on, every `field` sweep fails at once with VIDEO_DEVICE_MAPPING_PENDING
# and nothing re-queues a failed sweep. Off, submitted sweeps wait as `queued` and run once it is turned on.
# Turn on early only to demo `simulated` sweeps (docs/deploy/vps.md step 3).
SurveyProcessing__Enabled=false
SurveyProcessing__Frames__Detector=yolo
