<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LuxMap.Shared\LuxMap.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      BE-11. These two packages live HERE and nowhere else: LuxMap.Shared is referenced by every
      project including the two database-free test assemblies, and putting an S3 client or an image
      codec there would drag both into all of them.
    -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
