{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Connection": "Warning",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/luxmap-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "Ai": {
    "ModelSha256": "d778e343c6803b288504427a8084fda0dad960cef2b414c9d0dcb74d22373e81",
    "DayNight": {
      "ModelPath": "Models/daynight.onnx",
      "ModelSha256": "14ae7b00ab20c1ab185dbe95b08b668d949aefac160e408ae49df94aeea4edc0",
      "ConfidenceThreshold": 0.7
    }
  },
  "WorkOrders": {
    "AutoDispatch": {
      "LeadDays": 2,
      "QuotaPerDay": 2,
      "MaxPolesPerOrder": 8
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "luxmap-api",
    "Audience": "luxmap-clients",
    "AccessTokenMinutes": 60,
    "RefreshSlidingDays": 30,
    "RefreshAbsoluteDays": 90,
    "ReuseGraceSeconds": 30
  },
  "WebAuth": {
    "PersistentSlidingDays": 14,
    "SessionHours": 12
  }
}
