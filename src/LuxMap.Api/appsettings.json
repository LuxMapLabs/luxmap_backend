{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Connection": "Warning",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/luxmap-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "Ai": {
    "ModelSha256": "340e50f481b6618a4ffcfc115b0425b00e568153f145e4e03db657bc56f0b6e8"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "luxmap-api",
    "Audience": "luxmap-clients",
    "AccessTokenMinutes": 60,
    "RefreshSlidingDays": 30,
    "RefreshAbsoluteDays": 90,
    "ReuseGraceSeconds": 30
  },
  "WebAuth": {
    "PersistentSlidingDays": 14,
    "SessionHours": 12
  },
  "Iot": {
    "OfflineAfter": "01:00:00"
  }
}
